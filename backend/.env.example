VULNTRACK_ENV=development
VULNTRACK_DB=vulntrack-v2.db
VULNTRACK_SOURCE_ROOT=
VULNTRACK_JWT_SECRET=
VULNTRACK_ADMIN_USERNAME=admin
VULNTRACK_ADMIN_PASSWORD=admin
VULNTRACK_DEVELOPER_USERNAME=developer
VULNTRACK_DEVELOPER_PASSWORD=dev
FRONTEND_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
PORT=5001

# Optional AI remediation. Keep the key private; don't commit .env.
OPENROUTER_API_KEY=OPENROUTER_API_KEY=your_openrouter_api_key_here
VULNTRACK_AI_MODEL=openrouter/free
# Optional legacy direct OpenAI fallback when the OpenRouter key is empty.
OPENAI_API_KEY=

# Dependency audits use npm audit and pip-audit when manifests are present.
VULNTRACK_DEPENDENCY_AUDIT=1
VULNTRACK_AI_REQUESTS_PER_MINUTE=5
